#!/usr/bin/env bash
#
# secret — one source of truth for API keys, backed by the macOS Keychain.
#
#   secret set <name> [value]      store/update a secret (prompts hidden if value omitted)
#   secret get <name>              print a secret to stdout
#   secret rm <name>               delete a secret
#   secret rename <old> <new>      move a secret to a new name
#   secret has <name>              exit 0 if stored, non-zero if not (silent)
#   secret ensure <name>           reuse if present; else print the vendor's create-key URL
#   secret list                    table of all stored secrets + cached health
#   secret rotations               show secrets flagged for rotation (reminders only)
#   secret init [dir]              scaffold a .secrets.map from a project's .env, importing keys
#   secret push <target> [dir]     push a project's secrets to github|vercel|aws (--yes to apply)
#   secret run [-f map] -- <cmd>   inject a project's .secrets.map as env, then exec <cmd>
#   secret env  [-f map]           print `export VAR=...` lines for the current .secrets.map
#   secret doctor                  probe every live key, cache status into the registry
#
# Secrets live in the login keychain under service "claude-secret:<name>", account "$USER".
# Non-secret metadata (vendor, create-URL, health check) lives in registry.toml — safe to sync.

set -euo pipefail

PREFIX="claude-secret:"
ACCOUNT="${USER:-$(id -un)}"
CONFIG_DIR="${CLAUDE_SECRETS_DIR:-$HOME/.config/claude-secrets}"
REGISTRY="$CONFIG_DIR/registry.toml"
STATUS_CACHE="$CONFIG_DIR/status.tsv"   # name<TAB>state<TAB>detail<TAB>checked_at

die()  { printf 'secret: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

_svc() { printf '%s%s' "$PREFIX" "$1"; }

# --- core keychain ops -------------------------------------------------------

kc_get() {  # kc_get <name> -> value on stdout, non-zero if absent
  security find-generic-password -a "$ACCOUNT" -s "$(_svc "$1")" -w 2>/dev/null
}

kc_set() {  # kc_set <name> <value>
  # Note: security(1) only accepts the value via -w, so it is briefly visible in this
  # process's argv while the command runs. Avoid running this on shared multi-user hosts.
  security add-generic-password -U -a "$ACCOUNT" -s "$(_svc "$1")" \
    -l "$(_svc "$1")" -w "$2" -D "api key" \
    -j "managed by the 'secret' CLI" >/dev/null
}

kc_rm() {   # kc_rm <name>
  security delete-generic-password -a "$ACCOUNT" -s "$(_svc "$1")" >/dev/null 2>&1
}

kc_names() { # list every stored secret name (strip prefix), sorted
  security dump-keychain 2>/dev/null \
    | sed -n 's/.*"svce"<blob>="'"$PREFIX"'\(.*\)"/\1/p' \
    | sort -u
}

# --- registry helpers (tiny TOML reader, good enough for flat [name] tables) --

# reg_field <name> <field> -> value (empty if unset)
reg_field() {
  [ -f "$REGISTRY" ] || return 0
  awk -v want="$1" -v field="$2" '
    /^\[/ { insec = ($0 == "[" want "]") }
    insec && $0 ~ "^[[:space:]]*" field "[[:space:]]*=" {
      sub("^[^=]*=[[:space:]]*", ""); gsub(/^"|"$/, ""); print; exit
    }
  ' "$REGISTRY"
}

reg_names() {  # every [section] in the registry
  [ -f "$REGISTRY" ] || return 0
  sed -n 's/^\[\(.*\)\]$/\1/p' "$REGISTRY"
}

# --- status cache ------------------------------------------------------------

cache_state()  { [ -f "$STATUS_CACHE" ] && awk -F'\t' -v n="$1" '$1==n{print $2; found=1} END{if(!found)print "?"}' "$STATUS_CACHE" || echo "?"; }
cache_detail() { [ -f "$STATUS_CACHE" ] && awk -F'\t' -v n="$1" '$1==n{print $3}' "$STATUS_CACHE" || true; }

# --- map file resolution -----------------------------------------------------

find_map() {  # walk up from CWD for a .secrets.map
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/.secrets.map" ] && { printf '%s\n' "$d/.secrets.map"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

# emit_env <mapfile> -> lines of `export VAR=value`, resolving each mapped secret.
# A map line is `VAR = name` or `VAR = name|field`, where field ∈ {id,secret}
# splits an "id:secret" blob (used for AWS access-key pairs).
emit_env() {
  local mapfile="$1" var spec name field val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"                            # strip comments
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    var="${line%%=*}";  spec="${line#*=}"
    var="$(printf '%s' "$var" | tr -d '[:space:]')"
    spec="$(printf '%s' "$spec" | tr -d '[:space:]')"
    [ -z "$var" ] && continue
    # The output is eval'd by `run`/`push`, and .secrets.map files are committed (and may
    # come from someone else's repo), so only accept plain shell identifiers.
    if ! [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      info "secret: WARNING skipping invalid variable name in $mapfile: '$var'"
      continue
    fi
    name="${spec%%|*}"; field="${spec#*|}"; [ "$field" = "$spec" ] && field=""
    if val="$(kc_get "$name")"; then
      case "$field" in
        id)     val="${val%%:*}";;
        secret) val="${val#*:}";;
      esac
      printf 'export %s=%q\n' "$var" "$val"
    else
      info "secret: WARNING '$name' (for \$$var) not in keychain — run: secret ensure $name"
    fi
  done < "$mapfile"
}

# --- subcommands -------------------------------------------------------------

cmd_set() {
  local name="${1:?usage: secret set <name> [value]}" val="${2:-}"
  if [ -z "$val" ]; then
    read -r -s -p "value for '$name': " val; echo >&2
    [ -z "$val" ] && die "empty value, aborted"
  fi
  kc_set "$name" "$val"
  info "stored: $name"
}

cmd_get() {
  local name="${1:?usage: secret get <name>}"
  kc_get "$name" || die "no secret named '$name' (try: secret ensure $name)"
}

cmd_rm() {
  local name="${1:?usage: secret rm <name>}"
  kc_rm "$name" && info "deleted: $name" || die "no secret named '$name'"
}

cmd_rename() {
  local old="${1:?}" new="${2:?usage: secret rename <old> <new>}" val
  val="$(kc_get "$old")" || die "no secret named '$old'"
  kc_set "$new" "$val"; kc_rm "$old"
  info "renamed: $old -> $new"
}

cmd_has() { kc_get "${1:?usage: secret has <name>}" >/dev/null 2>&1; }

cmd_ensure() {
  local name="${1:?usage: secret ensure <name>}" val
  if val="$(kc_get "$name")"; then
    printf '%s\n' "$val"; return 0
  fi
  info "secret: '$name' is NOT stored yet."
  local url vendor; url="$(reg_field "$name" create_url)"; vendor="$(reg_field "$name" vendor)"
  [ -n "$vendor" ] && info "  vendor:  $vendor"
  if [ -n "$url" ]; then
    info "  Before creating a NEW key, check the dashboard for an existing one:"
    info "    $url"
  else
    info "  (no create_url in registry — add one under [$name] in $REGISTRY)"
  fi
  info "  Then store it with:"
  info "    secret set $name"
  return 3
}

cmd_list() {
  local names state detail have
  have="$(kc_names || true)"
  printf '%-28s %-8s %s\n' "NAME" "STATE" "DETAIL / SOURCE"
  printf '%-28s %-8s %s\n' "----" "-----" "---------------"
  # stored secrets
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    state="$(cache_state "$n")"; detail="$(cache_detail "$n")"
    case "$state" in
      live) state="OK";; dead) state="DEAD";; "?"|"") state="stored";;
    esac
    printf '%-28s %-8s %s\n' "$n" "$state" "$detail"
  done <<< "$have"
  # registry services with no stored key -> MISSING
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    if ! grep -qxF "$n" <<< "$have"; then
      printf '%-28s %-8s %s\n' "$n" "MISSING" "create: $(reg_field "$n" create_url)"
    fi
  done <<< "$(reg_names)"
}

cmd_rotations() {
  local any=0 n prio flagged reason url state
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    reason="$(reg_field "$n" rotate_reason)"; [ -z "$reason" ] && continue
    any=1
    prio="$(reg_field "$n" rotate_prio)"; flagged="$(reg_field "$n" rotate_flagged)"
    url="$(reg_field "$n" create_url)"; state="$(cache_state "$n")"
    case "$state" in live) state="live";; dead) state="DEAD";; *) state="unknown";; esac
    printf '\n  ⚠️  %s   [%s priority · flagged %s · currently %s]\n' \
      "$n" "${prio:-?}" "${flagged:-?}" "$state"
    printf '      %s\n' "$reason"
    [ -n "$url" ] && printf '      rotate at: %s\n' "$url"
  done < <(reg_names)
  if [ "$any" = 0 ]; then
    echo "No secrets flagged for rotation. 🎉"
  else
    echo
    echo "  Nothing is rotated automatically — these are reminders. After you rotate one,"
    echo "  run 'secret set <name>' with the new value and it drops off this list once the"
    echo "  rotate_reason is cleared from the registry (ask Claude, or edit registry.toml)."
  fi
}

# reverse lookup: given a value, print the vault name that already holds it (first match)
kc_name_for_value() {
  local target="$1" n v
  while IFS= read -r n; do
    [ -z "$n" ] && continue
    v="$(kc_get "$n")" || continue
    [ "$v" = "$target" ] && { printf '%s\n' "$n"; return 0; }
  done < <(kc_names)
  return 1
}

# suggest a vault name for an env var in a given project
suggest_name() {
  local var="$1" proj="$2" u; u="$(printf '%s' "$var" | tr 'a-z' 'A-Z')"
  case "$u" in
    OPENROUTER_API_KEY|OPENROUTER_KEY)        echo "openrouter/$proj";;
    RESEND_API_KEY|RESEND_KEY)                echo "resend";;
    ELEVENLABS_API_KEY|ELEVEN_API_KEY|XI_API_KEY) echo "elevenlabs";;
    ELEVENLABS_VOICE_ID|ELEVEN_VOICE_ID)      echo "voice/default";;
    FIRECRAWL_API_KEY|FIRECRAWL_KEY)          echo "firecrawl";;
    PERPLEXITY_API_KEY|PPLX_API_KEY)          echo "perplexity";;
    PAGESPEED_API_KEY)                        echo "google/pagespeed";;
    GOOGLE_PLACES_API_KEY)                    echo "google/places";;
    GOOGLE_CLIENT_ID)                         echo "google/$proj-client-id";;
    GOOGLE_CLIENT_SECRET)                     echo "google/$proj-client-secret";;
    VERCEL_TOKEN)                             echo "vercel";;
    CLERK_SECRET_KEY)                         echo "clerk/$proj";;
    STRIPE_SECRET_KEY)                        echo "stripe/$proj";;
    GITHUB_TOKEN|GH_TOKEN)                    echo "github/$proj";;
    TELEGRAM_BOT_TOKEN|TELEGRAM_TOKEN)        echo "telegram/$proj";;
    AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY)  echo "aws/$proj";;   # handled as a blob pair
    *) # generic: strip common suffixes, lowercase, namespace under project
       local base; base="$(printf '%s' "$u" | sed -E 's/_(API_)?(KEY|TOKEN|SECRET)$//' | tr 'A-Z_' 'a-z-')"
       echo "${base:-secret}/$proj";;
  esac
}

_placeholder() {  # crude: is this value obviously not a real secret?
  local v="$1" lv; lv="$(printf '%s' "$v" | tr 'A-Z' 'a-z')"
  [ ${#v} -lt 12 ] && return 0
  case "$lv" in *your*|*example*|*placeholder*|*changeme*|*xxxx*|*replace*|'<'*|'${'*|*todo*) return 0;; esac
  return 1
}

cmd_init() {
  local dir="${1:-$PWD}" proj src map out=".secrets.map"
  dir="$(cd "$dir" && pwd)"; proj="$(basename "$dir")"
  map="$dir/$out"
  # pick a source env file
  for f in .env .env.local .env.example .env.sample; do
    [ -f "$dir/$f" ] && { src="$dir/$f"; break; }
  done
  [ -n "${src:-}" ] || die "no .env/.env.local/.env.example in $dir to scaffold from"
  info "scanning $(basename "$src") in $proj/ …"

  local lines="" awsid="" awssec="" awsseen=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%$'\r'}"; line="${line#"${line%%[![:space:]]*}"}"
    [ -z "$line" ] && continue; case "$line" in \#*|//*) continue;; esac
    case "$line" in *=*) : ;; *) continue;; esac
    local var val; var="${line%%=*}"; val="${line#*=}"
    var="$(printf '%s' "$var" | sed -E 's/^export +//; s/[[:space:]]//g')"
    val="$(printf '%s' "$val" | sed -E 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//; s/^'\''//; s/'\''$//')"
    case "$var" in *KEY*|*TOKEN*|*SECRET*|*PASSWORD*|*VOICE*|*CLIENT_ID*|*DSN*|*WEBHOOK*) : ;; *) continue;; esac
    [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { info "  skipping invalid variable name: '$var'"; continue; }

    # AWS pair -> single blob entry
    if [ "$var" = "AWS_ACCESS_KEY_ID" ]; then awsid="$val"; awsseen=1; continue; fi
    if [ "$var" = "AWS_SECRET_ACCESS_KEY" ]; then awssec="$val"; awsseen=1; continue; fi

    local name existing
    if _placeholder "$val"; then
      name="$(suggest_name "$var" "$proj")"
      lines+="$var = $name"$'\n'
      info "  $var -> $name   (placeholder in file; ensure it's stored: secret ensure $name)"
    elif existing="$(kc_name_for_value "$val")"; then
      lines+="$var = $existing"$'\n'
      info "  $var -> $existing   (already in vault ✅ reused)"
    else
      name="$(suggest_name "$var" "$proj")"
      if kc_get "$name" >/dev/null 2>&1; then
        # Never overwrite: the vault already holds a DIFFERENT value under this name.
        lines+="# $var = $name   # NOT imported: vault already has a different value under '$name'"$'\n'
        info "  $var -> SKIPPED  (vault already has '$name' with a different value — not overwriting."
        info "           To keep both: secret set $name-$proj, then point $var at it in $out)"
      else
        kc_set "$name" "$val"
        lines+="$var = $name"$'\n'
        info "  $var -> $name   (imported new value into vault)"
      fi
    fi
  done < "$src"

  if [ "$awsseen" = 1 ] && [ -n "$awsid" ] && [ -n "$awssec" ]; then
    local aname="" existing blob="$awsid:$awssec"
    if existing="$(kc_name_for_value "$blob")"; then
      aname="$existing"; info "  AWS pair -> $aname   (already in vault ✅ reused)"
    elif kc_get "aws/$proj" >/dev/null 2>&1; then
      lines+="# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: NOT imported — vault already has a different 'aws/$proj'"$'\n'
      info "  AWS pair -> SKIPPED  (vault already has a different 'aws/$proj' — not overwriting)"
    else
      aname="aws/$proj"; kc_set "$aname" "$blob"; info "  AWS pair -> $aname   (imported id:secret blob)"
    fi
    if [ -n "$aname" ]; then
      lines+="AWS_ACCESS_KEY_ID = $aname|id"$'\n'
      lines+="AWS_SECRET_ACCESS_KEY = $aname|secret"$'\n'
    fi
  fi

  [ -n "$lines" ] || die "no secret-like vars found in $(basename "$src")"
  if [ -f "$map" ]; then cp "$map" "$map.bak"; info "backed up existing map -> $out.bak"; fi
  { echo "# $proj — generated by 'secret init' from $(basename "$src"). Safe to commit."
    echo "# Run with:  secret run -- <cmd>"
    printf '%s' "$lines"; } > "$map"
  info "wrote $out ($(grep -c '=' "$map") mappings). Review it, then: secret run -- <cmd>"
}

# secret push <target> [project-dir] [--yes]
#   Resolve this project's .secrets.map and push each secret to a cloud platform's
#   own store. DRY-RUN by default; pass --yes to actually write.
cmd_push() {
  local target="${1:?usage: secret push <github|vercel|aws> [dir] [--yes]}"; shift || true
  local dir="$PWD" doit=0 a
  for a in "$@"; do
    case "$a" in --yes|-y) doit=1;; *) [ -d "$a" ] && dir="$a";; esac
  done
  dir="$(cd "$dir" && pwd)"
  local map; map="$(cd "$dir" && find_map)" || die "no .secrets.map in $dir (run: secret init)"
  [ "$doit" = 1 ] || info "DRY-RUN (add --yes to actually push). Target: $target"

  # collect VAR=value pairs from the resolved map (skip AWS self-token nonsense)
  local envlines; envlines="$(emit_env "$map")"
  # shellcheck disable=SC1090
  eval "$envlines"
  local vars; vars="$(printf '%s\n' "$envlines" | sed -E 's/^export ([^=]+)=.*/\1/')"

  case "$target" in
    github)
      command -v gh >/dev/null || die "gh CLI not installed"
      local repo; repo="$(git -C "$dir" config --get remote.origin.url 2>/dev/null | sed -E 's#.*github.com[:/]##; s/\.git$//')"
      [ -n "$repo" ] || die "no github remote in $dir"
      info "repo: $repo"
      while IFS= read -r v; do [ -z "$v" ] && continue
        # value goes over stdin, never argv
        if [ "$doit" = 1 ]; then printf '%s' "${!v}" | gh secret set "$v" --repo "$repo" && info "  ✓ $v"
        else info "  would: gh secret set $v --repo $repo"; fi
      done <<< "$vars" ;;
    vercel)
      local token proj pid; token="$(kc_get vercel)" || die "no 'vercel' secret in vault"
      proj="$(basename "$dir")"; [ -f "$dir/.vercel/project.json" ] && \
        pid="$(sed -n 's/.*"projectId":"\([^"]*\)".*/\1/p' "$dir/.vercel/project.json")"
      info "vercel project: ${pid:-$proj}"
      while IFS= read -r v; do [ -z "$v" ] && continue; [ "$v" = "VERCEL_TOKEN" ] && continue
        if [ "$doit" = 1 ]; then
          # token via a header file descriptor and body via stdin, so neither lands in argv
          printf '%s' "${!v}" \
            | python3 -c 'import json,sys;print(json.dumps({"key":sys.argv[1],"value":sys.stdin.read(),"type":"encrypted","target":["production","preview","development"]}))' "$v" \
            | curl -s -X POST "https://api.vercel.com/v10/projects/${pid:-$proj}/env" \
                -H @<(printf 'Authorization: Bearer %s\n' "$token") -H 'Content-Type: application/json' \
                --data-binary @- >/dev/null && info "  ✓ $v" || info "  ✗ $v (check project id / token)"
        else info "  would: POST vercel env $v -> project ${pid:-$proj}"; fi
      done <<< "$vars" ;;
    aws)
      command -v aws >/dev/null || die "aws CLI not installed"
      local prefix; prefix="$(basename "$dir")"
      while IFS= read -r v; do [ -z "$v" ] && continue
        local sid="$prefix/$v"
        if [ "$doit" = 1 ]; then
          # value via stdin (file:///dev/stdin), never argv
          if aws secretsmanager describe-secret --secret-id "$sid" >/dev/null 2>&1; then
            printf '%s' "${!v}" | aws secretsmanager put-secret-value --secret-id "$sid" --secret-string file:///dev/stdin >/dev/null 2>&1
          else
            printf '%s' "${!v}" | aws secretsmanager create-secret --name "$sid" --secret-string file:///dev/stdin >/dev/null 2>&1
          fi && info "  ✓ $sid" || info "  ✗ $sid (check AWS credentials / region)"
        else info "  would: aws secretsmanager put-secret-value --secret-id $sid"; fi
      done <<< "$vars" ;;
    *) die "unknown push target '$target' (github|vercel|aws)";;
  esac
  [ "$doit" = 1 ] || info "Nothing was pushed. Re-run with --yes when ready."
}

cmd_env() {
  local mapfile=""
  [ "${1:-}" = "-f" ] && { mapfile="${2:?}"; shift 2; }
  [ -z "$mapfile" ] && mapfile="$(find_map)" || true
  [ -n "$mapfile" ] && [ -f "$mapfile" ] || die "no .secrets.map found (cwd or parents); pass -f <file>"
  emit_env "$mapfile"
}

cmd_run() {
  local mapfile=""
  [ "${1:-}" = "-f" ] && { mapfile="${2:?}"; shift 2; }
  [ "${1:-}" = "--" ] && shift
  [ "$#" -gt 0 ] || die "usage: secret run [-f map] -- <command...>"
  [ -z "$mapfile" ] && mapfile="$(find_map)" || true
  [ -n "$mapfile" ] && [ -f "$mapfile" ] || die "no .secrets.map found (cwd or parents); pass -f <file>"
  # shellcheck disable=SC1090
  eval "$(emit_env "$mapfile")"
  exec "$@"
}

cmd_doctor() {
  local checker="$CONFIG_DIR/doctor.sh"
  # fall back to the doctor.sh that ships next to this script
  [ -f "$checker" ] || checker="$(cd "$(dirname "$0")" && pwd)/doctor.sh"
  [ -f "$checker" ] || die "no doctor.sh in $CONFIG_DIR or next to $0"
  SECRET_BIN="$0" REGISTRY="$REGISTRY" STATUS_CACHE="$STATUS_CACHE" bash "$checker"
}

usage() {
  # print the leading comment block (skip the shebang), stopping at the first non-comment line
  awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"
}

# --- dispatch ----------------------------------------------------------------

cmd="${1:-}"; shift || true
case "$cmd" in
  set)     cmd_set    "$@";;
  get)     cmd_get    "$@";;
  rm|del)  cmd_rm     "$@";;
  rename|mv) cmd_rename "$@";;
  has)     cmd_has    "$@";;
  ensure)  cmd_ensure "$@";;
  list|ls) cmd_list   "$@";;
  rotations|rotate) cmd_rotations "$@";;
  init)    cmd_init   "$@";;
  push)    cmd_push   "$@";;
  env)     cmd_env    "$@";;
  run)     cmd_run    "$@";;
  doctor)  cmd_doctor "$@";;
  ""|help|-h|--help) usage;;
  *) die "unknown command '$cmd' (try: secret help)";;
esac
