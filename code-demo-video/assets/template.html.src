<!doctype html>
<!--
  code-demo-video template — DO NOT EDIT GENERATED COPIES BY HAND.
  build-demo.mjs fills the duration/brand placeholders and the AUDIO / SCENES /
  CAPTIONS / TIMELINE / DEMO_DATA markers. Re-run `node build-demo.mjs` after any
  spec or audio change.
-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"
      integrity="sha384-sG0Hv1tP1lZCk9KQmrIbY/XNwi+OY84GQqhMscbnsoBFqAz8KNCil1kvfL3Hbbk2"
      crossorigin="anonymous"
    ></script>
    <style>
      @font-face {
        font-family: "Bricolage Grotesque";
        src: url("fonts/BricolageGrotesque-Variable.woff2") format("woff2");
        font-weight: 200 800;
        font-style: normal;
        font-display: block;
      }
      :root {
        --bg: #0e1116;
        --accentA: #5bb8ff; /* primary accent (azure) */
        --accentB: #ffc83d; /* secondary accent (gold) */
        --inkHi: #f4f8fc;
        --inkMid: #b9c9d8;
        --inkMeta: #8fb6d9;
        --glowA: rgba(91, 184, 255, 0.2);
        --glowA0: rgba(91, 184, 255, 0);
        --glowB: rgba(255, 200, 61, 0.15);
        --glowB0: rgba(255, 200, 61, 0);
      }
      /* a brand.json's video.code_theme overrides these variables on body.brand-<name> (build-demo.mjs) */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #000;
      }
      body {
        font-family: "Bricolage Grotesque", sans-serif;
        color: var(--inkHi);
      }
      .mono {
        font-family: "JetBrains Mono", monospace;
      }
      .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: var(--bg);
      }
      .glow {
        position: absolute;
        border-radius: 50%;
      }
      .glow-a {
        background: radial-gradient(circle, var(--glowA) 0%, var(--glowA0) 65%);
      }
      .glow-b {
        background: radial-gradient(circle, var(--glowB) 0%, var(--glowB0) 65%);
      }

      /* ============ TITLE SCENE ============ */
      .ttl-ghost {
        position: absolute;
        bottom: -45px;
        left: -60px;
        font-family: "JetBrains Mono", monospace;
        font-size: 150px;
        font-weight: 700;
        white-space: nowrap;
        color: var(--accentA);
        opacity: 0;
        letter-spacing: -0.04em;
      }
      .ttl-content {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        height: 100%;
        padding: 120px 150px;
        gap: 28px;
      }
      .ttl-meta {
        display: flex;
        align-items: center;
        gap: 24px;
        font-family: "JetBrains Mono", monospace;
        font-size: 24px;
        letter-spacing: 0.22em;
        color: var(--inkMeta);
      }
      .ttl-meta-rule {
        width: 90px;
        height: 3px;
        background-color: var(--accentA);
        transform-origin: left center;
      }
      .ttl-hero {
        font-size: 150px;
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -0.04em;
        color: var(--inkHi);
        max-width: 1620px;
      }
      .ttl-hero .accent {
        color: var(--accentA);
      }
      .ttl-bar {
        width: 460px;
        height: 10px;
        border-radius: 5px;
        background-color: var(--accentB);
        transform-origin: left center;
      }
      .ttl-sub {
        font-size: 42px;
        font-weight: 350;
        color: var(--inkMid);
        max-width: 1500px;
      }
      .ttl-chip {
        position: absolute;
        right: 130px;
        bottom: 110px;
        font-family: "JetBrains Mono", monospace;
        font-size: 22px;
        letter-spacing: 0.14em;
        color: var(--accentB);
        border: 2px solid var(--accentB);
        border-radius: 999px;
        padding: 14px 30px;
        opacity: 0.9;
      }
      .ttl-corner {
        position: absolute;
        width: 56px;
        height: 56px;
        border-color: var(--accentA);
        border-style: solid;
        opacity: 0.8;
      }
      .ttl-corner.tl {
        top: 70px;
        left: 80px;
        border-width: 4px 0 0 4px;
      }
      .ttl-corner.br {
        bottom: 70px;
        right: 80px;
        border-width: 0 4px 4px 0;
      }

      /* ============ EDITOR SCENE (VS Code Dark+ — never rebranded) ============ */
      .ed-label {
        position: absolute;
        top: 16px;
        left: 120px;
        font-family: "JetBrains Mono", monospace;
        font-size: 21px;
        letter-spacing: 0.2em;
        color: var(--inkMeta);
      }
      .ed-label-r {
        position: absolute;
        top: 18px;
        right: 120px;
        font-family: "JetBrains Mono", monospace;
        font-size: 19px;
        letter-spacing: 0.16em;
        color: var(--inkMeta);
        opacity: 0.75;
      }
      /* VS Code window: the real app's CSS, inlined by build-demo.mjs from vscode/ (vscode-window.css + theme) */
      /*__VSCODE_CSS__*/

      /* ---- annotations INSIDE the window: logical px (the window is drawn at 2x, like a Retina screen) ---- */
      .mk-box {
        position: absolute;
        border: 1.25px solid #ff3b3b;
        border-radius: 3px;
        background: rgba(255, 59, 59, 0.1);
        box-shadow: 0 0 8px 1px rgba(255, 59, 59, 0.45);
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
        z-index: 6;
      }
      /* doc-slide marks (outside the window, real px) */
      .mk {
        border-radius: 6px;
        padding: 0 2px;
        margin: 0 -2px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }
      .mk.mk-chip {
        display: inline-block;
        padding: 0;
        margin: 0;
        line-height: 1.25;
      }
      /* fallback token colors (Dark 2026) for code the real-token pass did not cover; build-demo adds
         .c-RRGGBB classes for real tokens read from VS Code itself (vscode/tools/tokens.mjs) */
      .tok-kw { color: #c586c0; }
      .tok-decl { color: #ff7b72; }
      .tok-const { color: #569cd6; }
      .tok-fn { color: #d2a8ff; }
      .tok-str { color: #a5d6ff; }
      .tok-num { color: #b5cea8; }
      .tok-comment { color: #8b949e; }
      .tok-var { color: #c9d1d9; }
      .tok-type { color: #4ec9b0; }
      .tok-param { color: #ffa657; }
      .tok-op { color: #d4d4d4; }
      .tok-b1 { color: #ffd700; }
      .tok-b2 { color: #da70d6; }
      .tok-b3 { color: #179fff; }
      /* callouts are RIGHT-ANCHORED inside their code line (clear of the minimap + ruler) so they can never
         run off the window; the current line + the note read as a pair */
      .line-callout {
        position: absolute;
        right: calc(var(--vsc-mm) + 20px); /* 82: 6px clear of the minimap (62) + ruler (14) */
        top: calc((var(--vsc-lh) - 16px) / 2); /* 2.5: the 16px chip centered in the 21px row */
        z-index: 5;
        font-family: "JetBrains Mono", monospace;
        font-size: 9.5px;
        line-height: 14px;
        letter-spacing: 0.05em;
        color: var(--accentB);
        background: rgba(14, 17, 22, 0.92);
        border: 1px solid var(--accentB);
        border-radius: 4px;
        padding: 0 7px;
        opacity: 0;
        white-space: nowrap;
        max-width: 310px;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .t-out-block {
        position: relative;
        display: inline-block;
        visibility: hidden;
      }
      .out-ring {
        position: absolute;
        top: 1px; /* never reach up into the line above */
        left: -7px;
        right: -7px;
        bottom: -2px;
        border: 1.5px solid var(--accentB);
        border-radius: 5px;
        opacity: 0;
        pointer-events: none;
      }
      .out-tag {
        position: absolute;
        top: 1px;
        left: calc(100% + 16px);
        white-space: nowrap;
        font-family: "JetBrains Mono", monospace;
        font-size: 10.5px;
        letter-spacing: 0.1em;
        color: var(--accentB);
        opacity: 0;
      }
      /* a wide output block: the tag sits under the ring's right end (next to the short prompt), inside the panel */
      .out-tag.below { left: auto; right: 0; top: calc(100% + 3px); }
      .t-out-block.full .out-ring { right: -2px; }
      /* ============ COMPARE SCENE (pixel test: real capture over the generated window) ============ */
      /* the real capture: a wrapper whose WIDTH is the share shown real (animated), the inner keeps the window's
         rounded corners so the uncovered part is exactly the generated window */
      .cmp-real { position: absolute; top: 62px; left: 110px; width: 850px; height: 872px; overflow: hidden; z-index: 20; }
      .cmp-real-in { position: absolute; left: 0; top: 0; width: 1700px; height: 872px; border-radius: 32px; overflow: hidden; }
      .cmp-real img { position: absolute; left: 0; top: 0; width: 1700px; height: 872px; }
      .cmp-real img.cmp-tl { left: 20px; top: 18px; width: 124px; height: 32px; }
      .cmp-seam { position: absolute; top: 40px; left: 110px; width: 3px; margin-left: -1.5px; height: 916px; background: var(--accentB); box-shadow: 0 0 18px 2px rgba(255, 200, 61, 0.55); z-index: 22; }
      .cmp-lab { position: absolute; bottom: -34px; white-space: nowrap; font-family: "JetBrains Mono", monospace; font-size: 19px; letter-spacing: 0.14em; color: var(--accentB); }
      .cmp-lab.l { right: 16px; }
      .cmp-lab.r { left: 16px; }
      .cmp-heat { position: absolute; top: 62px; left: 110px; width: 1700px; height: 872px; border-radius: 32px; overflow: hidden; z-index: 24; }
      .cmp-heat img { width: 1700px; height: 872px; }
      .cmp-stat { position: absolute; left: 990px; top: 668px; height: 80px; z-index: 26; padding: 0 34px; display: flex; align-items: center; border-radius: 12px; background: rgba(14, 17, 22, 0.9); border: 2px solid var(--accentB); font-family: "Bricolage Grotesque", sans-serif; font-size: 40px; font-weight: 700; color: var(--inkHi); white-space: nowrap; } /* sits on the empty rows 11-12 of the compare window */
      /* ============ DOCUMENT / HANDOUT SCENE ============ */
      .doc-sheet {
        position: absolute;
        top: 92px;
        left: 50%;
        transform: translateX(-50%);
        width: 1380px;
        height: 838px;
        background: #faf9f5;
        color: #1f1f1f;
        border-radius: 10px;
        box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
        padding: 60px 80px;
        overflow: hidden;
        font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
      }
      .doc-tag {
        font-family: "JetBrains Mono", monospace;
        font-size: 19px;
        letter-spacing: 0.16em;
        color: #58b97c;
        margin-bottom: 14px;
      }
      .doc-title {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 48px;
        font-weight: 800;
        color: #0b3d2e;
        letter-spacing: -0.02em;
        line-height: 1.08;
        margin-bottom: 26px;
      }
      .doc-body {
        font-size: 27px;
        line-height: 1.48;
        color: #2b2b2b;
      }
      .doc-body h2 {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 31px;
        font-weight: 700;
        color: #0b3d2e;
        margin: 24px 0 10px;
      }
      .doc-body p {
        margin: 0 0 14px;
      }
      .doc-body ol,
      .doc-body ul {
        margin: 0 0 14px;
        padding-left: 36px;
      }
      .doc-body li {
        margin-bottom: 10px;
      }
      /* code on slides must look exactly like what students type: JetBrains Mono ligatures turn
         >= into ≥ and == into one long bar (6.6 extended editor sign-off) */
      .doc-body .ex,
      .doc-body .codename,
      .vsc-code,
      .term-body {
        font-variant-ligatures: none;
        font-feature-settings: "liga" 0, "calt" 0;
      }
      .doc-body .ex {
        font-family: "JetBrains Mono", monospace;
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 18px 24px;
        border-radius: 9px;
        font-size: 20px;
        line-height: 1.4;
        white-space: pre;
        display: block;
      }
      .doc-body .codename {
        font-family: "JetBrains Mono", monospace;
        background: #eceadf;
        padding: 2px 9px;
        border-radius: 5px;
        font-size: 23px;
      }
      .doc-table {
        border-collapse: collapse;
        width: 100%;
        font-size: 23px;
      }
      .doc-table th,
      .doc-table td {
        border: 1px solid #cdc9bd;
        padding: 9px 16px;
        text-align: left;
      }
      .doc-table th {
        background: #eceadf;
        font-weight: 700;
      }
      .doc-table td.pts {
        text-align: center;
        width: 90px;
        font-weight: 700;
        color: #0b3d2e;
      }

      /* ============ BROWSER PREVIEW SCENE ============ */
      .brw {
        position: absolute;
        top: 84px;
        left: 260px;
        width: 1400px;
        height: 830px;
        border-radius: 14px;
        overflow: hidden;
        box-shadow:
          0 40px 90px rgba(0, 0, 0, 0.65),
          0 0 0 1px #3c3c3c;
        display: flex;
        flex-direction: column;
        background: #ffffff;
      }
      .brw-chrome {
        flex: none;
        background: #2b2b2e;
      }
      .brw-tabs {
        height: 50px;
        display: flex;
        align-items: flex-end;
        padding: 8px 16px 0;
        gap: 10px;
      }
      .brw-dots {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 0 10px 10px 4px;
      }
      .brw-dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
      }
      .brw-tab {
        height: 42px;
        background: #3c3c40;
        border-radius: 10px 10px 0 0;
        padding: 0 26px;
        display: flex;
        align-items: center;
        font-size: 19px;
        color: #e8e8e8;
        gap: 10px;
      }
      .brw-urlrow {
        height: 48px;
        background: #3c3c40;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 0 20px;
      }
      .brw-nav {
        color: #9a9aa0;
        font-size: 22px;
        font-family: "JetBrains Mono", monospace;
      }
      .brw-url {
        flex: 1;
        height: 34px;
        background: #28282b;
        border-radius: 17px;
        color: #b9b9c0;
        font-family: "JetBrains Mono", monospace;
        font-size: 17px;
        display: flex;
        align-items: center;
        padding: 0 20px;
      }
      .brw-page {
        flex: 1;
        padding: 80px 90px;
        overflow: hidden;
      }
      .brw-note {
        position: absolute;
        right: 300px;
        bottom: 140px;
        font-family: "JetBrains Mono", monospace;
        font-size: 23px;
        letter-spacing: 0.08em;
        color: var(--accentB);
        border: 2px solid var(--accentB);
        border-radius: 999px;
        padding: 13px 28px;
        background: rgba(14, 17, 22, 0.88);
        opacity: 0;
      }

      /* ============ PAUSE CARD SCENE ============ */
      .pc-inner, .pov-card, .pov-card * { font-variant-ligatures: none; } /* "==" must not draw as a ligature on pause cards (7.6) */
      .pc-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        height: 100%;
        padding: 110px 170px;
        gap: 30px;
      }
      .pc-glyph {
        display: flex;
        gap: 18px;
        margin-bottom: 6px;
      }
      .pc-glyph div {
        width: 30px;
        height: 96px;
        border-radius: 10px;
        background-color: var(--accentB);
      }
      .pc-badge {
        font-family: "JetBrains Mono", monospace;
        font-size: 25px;
        letter-spacing: 0.2em;
        color: #0e1116;
        background-color: var(--accentB);
        border-radius: 999px;
        padding: 10px 30px;
        font-weight: 700;
      }
      .pc-head {
        font-size: 96px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.05;
        color: var(--inkHi);
        max-width: 1580px;
      }
      .pc-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 8px;
      }
      .pc-item {
        display: flex;
        align-items: center;
        gap: 22px;
        font-size: 38px;
        font-weight: 350;
        color: var(--inkMid);
      }
      .pc-box {
        width: 34px;
        height: 34px;
        border: 3px solid var(--accentA);
        border-radius: 8px;
        flex: none;
      }
      .pc-hint {
        font-size: 28px;
        color: var(--inkMeta);
        font-family: "JetBrains Mono", monospace;
        margin-top: 6px;
      }
      .pc-foot {
        position: absolute;
        bottom: 100px;
        left: 170px;
        font-family: "JetBrains Mono", monospace;
        font-size: 24px;
        letter-spacing: 0.18em;
        color: var(--accentB);
      }

      /* ============ OVERLAY PAUSE (over the editor — code stays visible) ============ */
      /* Pause card sits in the cleared zone on the RIGHT after the editor scales down
         (see the editor-shrink tween in build-demo.mjs) — so it never overlaps code. */
      .pause-ov {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        z-index: 60;
      }
      .pov-card {
        position: relative;
        width: 486px;
        margin: 0 46px 0 0;
        background: rgba(11, 14, 19, 0.94);
        border: 2px solid var(--accentB);
        border-radius: 18px;
        padding: 24px 30px 20px;
        box-shadow: 0 26px 80px rgba(0, 0, 0, 0.6);
      }
      .pov-toprow {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 14px;
      }
      .pov-glyph {
        display: flex;
        gap: 6px;
      }
      .pov-glyph span {
        width: 9px;
        height: 27px;
        border-radius: 4px;
        background-color: var(--accentB);
      }
      .pov-badge {
        font-family: "JetBrains Mono", monospace;
        font-size: 16px;
        letter-spacing: 0.15em;
        font-weight: 700;
        color: #0e1116;
        background-color: var(--accentB);
        border-radius: 999px;
        padding: 5px 16px;
      }
      .pov-head {
        font-size: 31px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--inkHi);
        margin-bottom: 14px;
      }
      .pov-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }
      .pov-item {
        display: flex;
        align-items: center;
        gap: 13px;
        font-size: 21px;
        font-weight: 350;
        line-height: 1.3;
        color: var(--inkMid);
      }
      .pov-box {
        width: 20px;
        height: 20px;
        border: 2px solid var(--accentA);
        border-radius: 5px;
        flex: none;
      }
      .pov-hint {
        font-family: "JetBrains Mono", monospace;
        font-size: 17px;
        color: var(--inkMeta);
        margin-top: 14px;
      }
      .pov-foot {
        font-family: "JetBrains Mono", monospace;
        font-size: 15px;
        letter-spacing: 0.15em;
        color: var(--accentB);
        margin-top: 16px;
      }

      /* ============ STEPS OVERLAY (literal how-to steps, top-right) ============ */
      .steps-ov {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        z-index: 58;
      }
      .steps-ov.bottom {
        align-items: flex-end;
      }
      .steps-ov.bottom .steps-card {
        margin: 0 70px 205px 0; /* above the status bar, over the terminal's empty area */
      }
      .steps-card {
        margin: 150px 70px 0 0;
        width: 560px;
        background: rgba(11, 14, 19, 0.94);
        border: 2px solid #ff3b3b;
        border-radius: 14px;
        padding: 22px 28px;
        box-shadow: 0 22px 64px rgba(0, 0, 0, 0.55);
      }
      .steps-title {
        font-size: 25px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.01em;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .steps-title::before {
        content: "";
        width: 11px;
        height: 27px;
        background: #ff3b3b;
        border-radius: 3px;
        flex: none;
      }
      .steps-item {
        display: flex;
        align-items: baseline;
        gap: 14px;
        font-size: 22px;
        line-height: 1.4;
        color: #e6e6e6;
        margin-bottom: 11px;
      }
      .steps-num {
        color: #ff6b6b;
        font-weight: 700;
        font-size: 19px;
        flex: none;
      }

      /* ============ OUTRO SCENE ============ */
      .ot-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        height: 100%;
        padding: 110px 160px;
        gap: 34px;
      }
      .ot-head {
        font-size: 110px;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.04;
        color: var(--inkHi);
        max-width: 1620px;
      }
      .ot-head .accent {
        color: var(--accentA);
      }
      .ot-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-top: 8px;
      }
      .ot-item {
        display: flex;
        align-items: center;
        gap: 24px;
        font-size: 40px;
        font-weight: 350;
        color: var(--inkMid);
      }
      .ot-tick {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: var(--accentB);
        flex: none;
      }
      .ot-rule {
        position: absolute;
        bottom: 150px;
        left: 160px;
        width: 540px;
        height: 3px;
        background-color: var(--accentA);
        transform-origin: left center;
      }
      .ot-foot {
        position: absolute;
        bottom: 96px;
        left: 160px;
        font-family: "JetBrains Mono", monospace;
        font-size: 23px;
        letter-spacing: 0.18em;
        color: var(--inkMeta);
      }

      /* ============ BRAND SCENES: sting, recap, end screen ============
         BrandDisplay / BrandMono are the brand's own fonts (fonts/brand-*.woff2, copied by the build); without
         them these fall back to the template's fonts. Everything stays above y=960, clear of the captions. */
      .stg-mark {
        position: absolute;
        left: 560px;
        top: 300px;
        width: 800px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 34px;
      }
      .stg-ring {
        position: absolute;
        left: 210px;
        top: -10px;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        border: 5px solid var(--accentA);
        opacity: 0;
      }
      .stg-emb {
        display: block;
        width: 360px;
        height: 360px;
      }
      .stg-word {
        font-family: "BrandDisplay", "Bricolage Grotesque", sans-serif;
        font-weight: 900;
        font-size: 60px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--inkHi);
      }
      .stg-card {
        position: absolute;
        left: 860px;
        top: 330px;
        width: 960px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 22px;
      }
      .stg-chip {
        font-family: "BrandMono", "JetBrains Mono", monospace;
        font-weight: 700;
        font-size: 28px;
        letter-spacing: 0.16em;
        color: var(--accentB);
        border: 2px solid var(--accentB);
        border-radius: 8px;
        padding: 8px 18px;
      }
      .stg-title {
        font-family: "BrandDisplay", "Bricolage Grotesque", sans-serif;
        font-weight: 900;
        font-size: 82px;
        line-height: 1.04;
        letter-spacing: -0.01em;
        color: var(--inkHi);
      }
      .stg-course {
        font-family: "BrandMono", "JetBrains Mono", monospace;
        font-size: 26px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accentA);
      }
      .stg-free {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 10px;
        font-size: 34px;
        font-weight: 500;
        color: var(--inkMid);
      }
      .stg-arrow {
        font-weight: 800;
        color: var(--accentB);
      }
      .rcp-top {
        position: absolute;
        left: 160px;
        top: 110px;
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .rcp-emb {
        width: 72px;
        height: 72px;
      }
      .rcp-tag {
        font-family: "BrandMono", "JetBrains Mono", monospace;
        font-size: 26px;
        letter-spacing: 0.18em;
        color: var(--accentA);
      }
      .rcp-head {
        position: absolute;
        left: 160px;
        top: 220px;
        font-family: "BrandDisplay", "Bricolage Grotesque", sans-serif;
        font-weight: 900;
        font-size: 96px;
        letter-spacing: -0.01em;
        color: var(--inkHi);
      }
      .rcp-list {
        position: absolute;
        left: 160px;
        top: 410px;
        width: 1600px;
        display: flex;
        flex-direction: column;
        gap: 34px;
      }
      .rcp-item {
        display: flex;
        align-items: center;
        gap: 30px;
      }
      .rcp-n {
        flex: none;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--accentB);
        color: var(--bg);
        font-family: "BrandDisplay", "Bricolage Grotesque", sans-serif;
        font-weight: 900;
        font-size: 38px;
      }
      .rcp-t {
        font-size: 46px;
        font-weight: 500;
        line-height: 1.2;
        color: var(--inkHi);
      }
      .es-head {
        position: absolute;
        left: 0;
        right: 0;
        top: 120px;
        text-align: center;
        font-family: "BrandDisplay", "Bricolage Grotesque", sans-serif;
        font-weight: 900;
        font-size: 64px;
        color: var(--inkHi);
      }
      .es-slot {
        position: absolute;
        top: 280px;
        width: 760px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .es-left {
        left: 160px;
      }
      .es-right {
        left: 1000px;
      }
      .es-lab {
        font-family: "BrandMono", "JetBrains Mono", monospace;
        font-weight: 700;
        font-size: 26px;
        letter-spacing: 0.18em;
        color: var(--accentB);
      }
      .es-box {
        position: relative;
        width: 760px;
        height: 428px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 14px;
        border: 3px solid rgba(255, 255, 255, 0.14);
        background-color: rgba(255, 255, 255, 0.035);
      }
      .es-title {
        font-size: 38px;
        font-weight: 600;
        line-height: 1.2;
        color: var(--inkHi);
      }
      .es-foot {
        position: absolute;
        left: 0;
        right: 0;
        top: 880px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-family: "BrandMono", "JetBrains Mono", monospace;
        font-size: 24px;
        letter-spacing: 0.12em;
        color: var(--inkMeta);
      }
      .es-emb {
        width: 48px;
        height: 48px;
      }

      /* ============ CAPTIONS ============ */
      .cap-layer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 130px;
        z-index: 90;
        pointer-events: none;
      }
      .cap-g {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 30px;
        text-align: center;
        visibility: hidden;
        font-size: 35px;
        font-weight: 600;
        letter-spacing: 0.01em;
      }
      .cap-g span {
        opacity: 0.28;
        color: #ffffff;
        text-shadow:
          0 2px 10px rgba(0, 0, 0, 0.9),
          0 0 3px rgba(0, 0, 0, 0.9);
        padding: 0 0.14em;
      }
    </style>
  </head>
  <body class="__BRAND__">
    <div
      id="root"
      data-composition-id="main"
      data-start="0"
      data-duration="__DURATION__"
      data-width="1920"
      data-height="1080"
    >
      <!--__AUDIO__-->
      <!--__SCENES__-->
      <div class="cap-layer" data-layout-allow-overflow>
        <!--__CAPTIONS__-->
      </div>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      var tl = gsap.timeline({ paused: true });

      var D = /*__DEMO_DATA__*/ null;

      /* the minimap, drawn the way Monaco draws it (minimapCharRenderer, scale 2 on Retina): each character is a
         2x4 device-px cell from VS Code's own pre-baked atlas, softened by 12/15 for dark themes, blended from the
         background toward the token color; rows are 4 px tall, text starts 8 px in (the minimap's gutter) */
      var MM_ATLAS = (function (hex) {
        var raw = new Uint8ClampedArray(hex.length / 2);
        for (var i = 0; i < hex.length; i += 2) raw[i >> 1] = parseInt(hex.substr(i, 2), 16);
        var soft = new Uint8ClampedArray(raw.length);
        for (var j = 0; j < raw.length; j++) soft[j] = (raw[j] * 12 / 15) | 0;
        return soft;
      })("__MINIMAP_ATLAS__");
      var MM_BG = D.mmBg || "121314";
      function mmHexRGB(h) { return [parseInt(h.substr(0, 2), 16), parseInt(h.substr(2, 2), 16), parseInt(h.substr(4, 2), 16)]; }
      var MM_BGC = mmHexRGB(MM_BG);
      function mmCtx(id) { var cv = document.getElementById(id); return cv ? cv.getContext("2d") : null; }
      function mmChar(ctx, x, y, code, hex) {
        var s = code - 32, idx = s < 0 || s > 96 ? (s + 96) % 96 : s, off = idx * 8;
        var c = mmHexRGB(hex), im = ctx.createImageData(2, 4), d = im.data;
        for (var i = 0; i < 8; i++) {
          var k = MM_ATLAS[off + i] / 255;
          d[i * 4] = MM_BGC[0] + (c[0] - MM_BGC[0]) * k;
          d[i * 4 + 1] = MM_BGC[1] + (c[1] - MM_BGC[1]) * k;
          d[i * 4 + 2] = MM_BGC[2] + (c[2] - MM_BGC[2]) * k;
          d[i * 4 + 3] = 255;
        }
        ctx.putImageData(im, x, y);
      }
      function mmText(ctx, row, col, text, cols) {
        for (var k = 0; k < text.length; k++) {
          var code = text.charCodeAt(k), x = 8 + (col + k) * 2;
          if (x > ctx.canvas.width - 2) return;
          if (code !== 32 && code !== 9) mmChar(ctx, x, row * 4, code, cols[k] || "bbbebf");
        }
      }
      function mmClearRow(ctx, row) { ctx.fillStyle = "#" + MM_BG; ctx.fillRect(0, row * 4, ctx.canvas.width, 4); }
      (D.minimap || []).forEach(function (m) {
        var ctx = mmCtx(m.id);
        if (!ctx) return;
        ctx.fillStyle = "#" + MM_BG;
        ctx.fillRect(0, 0, ctx.canvas.width, ctx.canvas.height);
        m.rows.forEach(function (r) {
          if (r.at == null) mmText(ctx, r.row, 0, r.t, r.c);
          else tl.call(function () { mmText(ctx, r.row, 0, r.t, r.c); }, null, r.at);
        });
      });

      /* char-by-char typing via tl.call — safe to drive from data (not a tween,
         so the static linter has nothing to mis-attribute) */
      function typeInto(targets, start, cps, tails, st, times, mm) {
        var t = start;
        var ki = 0; // index into times[] (human rhythm), over the typed (non-instant) keys
        // minimap row state: chars typed so far + the auto-closed tail after the cursor (both are in the file)
        var ms = { n: 0, tt: "", tc: [] }, mctx = mm ? mmCtx(mm.id) : null;
        function mmRedraw() {
          if (!mctx) return;
          mmClearRow(mctx, mm.row);
          mmText(mctx, mm.row, 0, mm.t.substring(0, ms.n), mm.c);
          mmText(mctx, mm.row, ms.n, ms.tt, ms.tc);
        }
        var nTyped = 0;
        var col = 1; // status bar column after each keystroke (st: { id, ln })
        var stEl = st ? document.getElementById(st.id) : null;
        // auto-closed brackets/quotes sitting after the cursor (precomputed per keystroke by the build)
        (tails || []).forEach(function (x) {
          var te = document.getElementById(x.id);
          tl.call(function () { te.innerHTML = x.html; ms.tt = x.mt || ""; ms.tc = x.mc || []; mmRedraw(); }, null, x.t);
        });
        targets.forEach(function (tg) {
          var el = document.getElementById(tg.id);
          var pre = tg.pre || ""; // text already in the node (a terminal prompt): typing appends to the same text node
          if (tg.instant) {
            // auto-indent: VS Code puts the indentation in on Enter (tg.at), the typist starts after it
            (function (e, txt, at, n) {
              tl.call(function () { e.textContent = pre + txt; ms.n = n; mmRedraw(); }, null, at);
            })(el, tg.text, tg.at != null ? tg.at : t, nTyped + tg.text.length);
            t += tg.text.length / cps;
            col += tg.text.length;
            nTyped += tg.text.length;
            return;
          }
          for (var i = 0; i < tg.text.length; i++) {
            col++;
            if (times && times[ki] != null) t = times[ki];
            ki++;
            nTyped++;
            (function (e, txt, idx, at, c, n) {
              tl.call(
                function () {
                  e.textContent = pre + txt.substring(0, idx + 1);
                  if (stEl) stEl.textContent = "Ln " + st.ln + ", Col " + c;
                  ms.n = n;
                  mmRedraw();
                },
                null,
                at
              );
            })(el, tg.text, i, t, col, nTyped);
            t += 1 / cps;
          }
        });
        return t;
      }

      /* ALL tweens are emitted by build-demo.mjs as literal calls below —
         literal selectors + literal times keep `hyperframes lint` able to
         prove non-overlap. NEVER add variable-selector tweens here. */
      /*__TIMELINE__*/

      D.typing.forEach(function (a) {
        typeInto(a.targets, a.start, a.cps, a.tails, a.st, a.times, a.mm);
      });
      /* status bar Ln/Col (cursor moves, steps, pastes); keystrokes update it inside typeInto */
      (D.status || []).forEach(function (x) {
        var se = document.getElementById(x.id);
        tl.call(function () { se.textContent = x.txt; }, null, x.t);
      });

      /* captions: tl.set only (no duration → no overlap analysis) */
      D.captions.forEach(function (g) {
        tl.set("#" + g.id, { visibility: "visible" }, g.start);
        g.words.forEach(function (w) {
          tl.set("#" + w.id, { opacity: 1 }, w.t);
        });
        tl.set("#" + g.id, { visibility: "hidden" }, g.end);
      });

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
